---
/**
 * Pre-publication notice. Renders nothing for fully published pages.
 * Wording comes from the single status framework (src/data/status.ts) so the banner,
 * the trust chip, the search index and the sitemap can never tell a reader three
 * different stories about the same page.
 */
import { STATUS, type Status } from '../data/status';

interface Props { status?: Status }
const { status = 'template' } = Astro.props;
const meta = STATUS[status] ?? STATUS.template;
---

{status === 'template' && (
  <div class="callout callout--caution" role="note">
    <strong class="callout__title">Template — not yet published</strong>
    {meta.detail}
  </div>
)}

{status === 'draft' && (
  <div class="callout callout--caution" role="note">
    <strong class="callout__title">Source verification in progress</strong>
    {meta.detail}
  </div>
)}

{status === 'technical-review' && (
  <div class="callout" role="note">
    <strong class="callout__title">Technical review pending</strong>
    This page is editorially complete and its sources are listed below. It is awaiting
    subject-matter verification of its technical claims by a qualified roofing
    professional. It is general educational information — not an inspection, an
    engineering judgement, or advice about your specific building.
  </div>
)}

{status === 'preliminary' && (
  <div class="callout callout--caution" role="note">
    <strong class="callout__title">Published with limitations — preliminary data</strong>
    {meta.detail}. It is published openly so the methodology can be examined, not
    because the numbers are settled. Do not rely on it for planning or budgeting.
  </div>
)}
