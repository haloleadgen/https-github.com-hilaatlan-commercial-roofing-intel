---
/**
 * Trust strip under every headline.
 *
 * Every claim here is gated on `status` (src/data/status.ts). A page may only assert
 * what it has earned:
 *  - The status chip states the real publication state, in the reader's words.
 *  - "Reviewed by <editor>" renders only where an editorial review actually happened.
 *    It previously rendered unconditionally, so template pages claimed to have been
 *    reviewed by the Editor-in-Chief.
 *  - The source count is DERIVED from the structured sources array, never hand-typed,
 *    and only shows for statuses permitted to make that claim.
 *  - EDITORIAL review is labelled distinctly from TECHNICAL review. Hila is not a
 *    roofing technical expert; nothing here may imply subject-matter verification.
 *
 * The word "Evidence-based" no longer appears in this component. It was rendering on
 * 34 unpublished pages.
 */
import { STATUS, EDITOR, type Status } from '../data/status';
import { formatDate } from '../data/dates';
import type { Source } from '../data/sources';

interface Props {
  updated?: string;
  reviewed?: string;
  sources?: Source[];
  minutes?: number;
  status?: Status;
}
const {
  updated,
  reviewed = EDITOR,
  sources = [],
  minutes,
  status = 'template',
} = Astro.props;

const meta = STATUS[status] ?? STATUS.template;
// Derived, never declared.
const sourceCount = sources.length;
const fmt = (d: string) => formatDate(d);
---

<div class="trust-meta">
  <span class:list={['badge', `badge--status-${meta.tone}`]} title={meta.detail}>
    {meta.tone === 'evidence' && (
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    )}
    {meta.label}
  </span>

  {meta.showEditorialReview && <span>Editorial review: {reviewed}</span>}

  {status === 'technical-review' && (
    <span class="trust-meta__pending">Technical review: pending</span>
  )}

  {updated && <span>Updated <time datetime={updated}>{fmt(updated)}</time></span>}

  {meta.showSourceCount && sourceCount > 0 && (
    <span>
      <a href="#sources-heading">{sourceCount} {sourceCount === 1 ? 'source' : 'sources'} cited</a>
    </span>
  )}

  {typeof minutes === 'number' && <span>{minutes} min read</span>}

  <span>
    <a href="/about/editorial-standards/">Editorial standards</a> ·
    <a href="/about/corrections/">Report an error</a>
  </span>
</div>
