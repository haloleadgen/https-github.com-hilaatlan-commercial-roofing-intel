---
/**
 * Decision Tool template — working client-side estimator with on-page
 * methodology, assumptions, limitations, and explicit confidence language.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SampleNotice from '../../components/SampleNotice.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import TrustMeta from '../../components/TrustMeta.astro';

const related = [
  {
    title: 'Commercial Roof Life Expectancy Benchmarks',
    href: '/data-research/commercial-roof-life-expectancy-benchmarks/',
    type: 'Dataset',
    description: 'The benchmark data behind this estimator.',
  },
  {
    title: 'Repair or Replace? How to Decide',
    href: '/knowledge/guides/repair-or-replace/',
    type: 'Decision Guide',
    description: 'What to do with the estimate once you have it.',
  },
  {
    title: 'CRI Methodology',
    href: '/about/methodology/',
    type: 'Governance',
    description: 'How every CRI tool is built and validated.',
  },
];
---

<Base
  title="Roof Life Expectancy Estimator"
  description="Estimate the remaining service life of a commercial roof from system type, age, climate exposure, and maintenance history — with published methodology and stated uncertainty."
  noindex={true}
>
  <Breadcrumbs crumbs={[{ name: 'Tools', href: '/tools/' }, { name: 'Roof Life Expectancy Estimator' }]} />

  <article class="container section--tight" data-pagefind-body>
    <header>
      <p class="eyebrow" data-pagefind-filter="type">Decision Tool</p>
      <h1>Roof Life Expectancy Estimator</h1>
      <p class="lede">
        A planning-grade range for remaining service life, built on CRI’s published
        benchmarks. It cannot replace a physical condition assessment — and it will tell
        you when to get one.
      </p>
      {/* No sources= : this tool lists no external citations, and its own methodology
          states the modifier values are pre-validation placeholders. Claiming a
          citation count here contradicted the page's own disclosure. Restore a real
          count only when Benchmarks v1.0 ships with sources actually listed. */}
      <TrustMeta updated="2026-07-01" status="sample" />
    </header>

    <SampleNotice />

    <div class="grid grid--2" style="align-items: start; margin-top: var(--space-5);">
      <form class="tool-panel" id="rle-form" aria-describedby="rle-disclaimer" novalidate>
        <h2 style="margin-bottom: var(--space-4); font-size: var(--text-xl);">Your roof</h2>

        <div class="field">
          <label for="system">Roof system</label>
          <select id="system" name="system" required>
            <option value="tpo">TPO (single-ply, white)</option>
            <option value="epdm">EPDM (single-ply, rubber)</option>
            <option value="pvc">PVC (single-ply)</option>
            <option value="modbit">Modified bitumen</option>
            <option value="bur">Built-up (BUR)</option>
            <option value="metal">Metal (standing seam)</option>
          </select>
          <span class="hint">Not sure? The membrane type is on your warranty or last inspection report.</span>
        </div>

        <div class="field">
          <label for="age">Roof age (years)</label>
          <input id="age" name="age" type="number" inputmode="numeric" min="0" max="80" step="1" value="10" required aria-describedby="age-error" />
          <span class="hint" id="age-error" role="alert" style="color: var(--cri-alert);" hidden>Enter an age between 0 and 80 years.</span>
        </div>

        <div class="field">
          <label for="climate">Climate exposure</label>
          <select id="climate" name="climate">
            <option value="moderate">Moderate</option>
            <option value="hot">Hot / high-UV (cooling-dominated)</option>
            <option value="cold">Cold / freeze-thaw</option>
            <option value="coastal">Coastal / hurricane-exposed</option>
          </select>
          <span class="hint">Pick the condition that dominates your location.</span>
        </div>

        <div class="field">
          <label for="maintenance">Maintenance history</label>
          <select id="maintenance" name="maintenance">
            <option value="proactive">Proactive (scheduled inspections + repairs)</option>
            <option value="reactive" selected>Reactive (fixed when problems appear)</option>
            <option value="neglected">Minimal / unknown</option>
          </select>
        </div>

        <div class="field">
          <label for="ponding">Known ponding water?</label>
          <select id="ponding" name="ponding">
            <option value="no" selected>No</option>
            <option value="unsure">Not sure</option>
            <option value="yes">Yes — water sits more than 48 hours</option>
          </select>
        </div>

        <button class="btn" type="submit">Estimate remaining life</button>
      </form>

      <div>
        <div class="tool-result" id="rle-result" role="status" aria-live="polite" hidden>
          <p class="eyebrow" style="margin-bottom: var(--space-1);">Estimated remaining service life</p>
          <p class="tool-result__figure" id="rle-figure">—</p>
          <p id="rle-confidence" style="font-size: var(--text-xs); margin-top: var(--space-2); font-weight: 600;"></p>
          <p id="rle-note" style="font-size: var(--text-sm); margin-top: var(--space-3);"></p>
          <p style="font-size: var(--text-sm); margin-top: var(--space-3);">
            <strong>Next step:</strong> <span id="rle-next"></span>
          </p>
          <p style="font-size: var(--text-xs); color: var(--cri-slate-500); margin-top: var(--space-3);">
            Methodology v0.1 — modifier values are pre-validation placeholders.
            <a href="#methodology">Read the full methodology below.</a>
          </p>
        </div>
        <div class="callout" id="rle-disclaimer">
          <strong class="callout__title">Planning estimate only</strong>
          This range is derived from population-level benchmarks. Your roof’s actual
          condition can only be established by physical assessment (visual survey, moisture
          scan, core samples where warranted). This is educational content, not an
          engineering evaluation of your building.
        </div>
      </div>
    </div>

    <div class="prose" style="margin-top: var(--space-7);">
      <h2 id="methodology">Methodology</h2>
      <p>
        The estimator starts from the service-life ranges in the
        <a href="/data-research/commercial-roof-life-expectancy-benchmarks/">CRI Roof Life
        Expectancy Benchmarks</a> (v0.1), then applies documented modifiers:
      </p>
      <ul>
        <li><strong>Climate:</strong> hot/high-UV −10%, freeze-thaw −8%, coastal/hurricane −15%, moderate ±0.</li>
        <li><strong>Maintenance:</strong> proactive +12%, reactive ±0, minimal/unknown −18%.</li>
        <li><strong>Ponding water:</strong> −12% where reported. “Not sure” applies no modifier but lowers the stated confidence, because ponding is a major unobserved variable.</li>
      </ul>
      <p>
        Remaining life = adjusted range minus current age, floored at zero. Outputs are
        ranges by design; point estimates would overstate precision. The confidence label
        reflects how much of the variance the tool cannot see: it drops when inputs are
        unknown, when the roof is near or past the benchmark range, and always remains at
        most “moderate” until benchmarks v1.0 validation is complete.
      </p>

      <h2>Limitations</h2>
      <ul>
        <li>Does not model installation quality — the single largest variance driver in field studies.</li>
        <li>Does not detect existing moisture intrusion; only a survey can.</li>
        <li>Assumes the system was appropriate for the building at installation.</li>
        <li>Benchmark modifiers are v0.1 placeholders pending validation against field data.</li>
      </ul>
    </div>
  </article>

  <RelatedLinks items={related} />

  <script>
    const BASE: Record<string, [number, number]> = {
      tpo: [15, 25], epdm: [20, 30], pvc: [20, 30],
      modbit: [15, 25], bur: [20, 30], metal: [30, 45],
    };
    const CLIMATE: Record<string, number> = { moderate: 1.0, hot: 0.9, cold: 0.92, coastal: 0.85 };
    const MAINT: Record<string, number> = { proactive: 1.12, reactive: 1.0, neglected: 0.82 };

    const form = document.getElementById('rle-form') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const ageRaw = Number(data.get('age'));
      const ageErr = document.getElementById('age-error')!;
      if (!Number.isFinite(ageRaw) || ageRaw < 0 || ageRaw > 80) {
        ageErr.hidden = false;
        (document.getElementById('age') as HTMLInputElement).focus();
        return;
      }
      ageErr.hidden = true;

      const system = String(data.get('system'));
      const age = Math.round(ageRaw);
      const climate = String(data.get('climate'));
      const maint = String(data.get('maintenance'));
      const pondingChoice = String(data.get('ponding'));
      const ponding = pondingChoice === 'yes' ? 0.88 : 1.0;

      const factor = (CLIMATE[climate] ?? 1) * (MAINT[maint] ?? 1) * ponding;
      const [lo, hi] = BASE[system] ?? [15, 25];
      const adjLo = lo * factor;
      const adjHi = hi * factor;
      const remLo = Math.max(0, Math.round(adjLo - age));
      const remHi = Math.max(0, Math.round(adjHi - age));

      // Confidence: capped at "moderate" (v0.1); drops with unknowns and near end-of-life
      let confidence = 'Moderate';
      const reasons: string[] = [];
      if (pondingChoice === 'unsure') { confidence = 'Low'; reasons.push('ponding status unknown'); }
      if (maint === 'neglected') { confidence = 'Low'; reasons.push('maintenance history unknown or minimal'); }
      if (age >= adjHi) { confidence = 'Low'; reasons.push('age at or beyond the benchmark range'); }

      const fig = document.getElementById('rle-figure')!;
      const conf = document.getElementById('rle-confidence')!;
      const note = document.getElementById('rle-note')!;
      const next = document.getElementById('rle-next')!;
      const result = document.getElementById('rle-result')!;

      conf.textContent = `Confidence: ${confidence}${reasons.length ? ' — ' + reasons.join('; ') : ''}`;
      conf.style.color = confidence === 'Low' ? 'var(--cri-caution)' : 'var(--cri-evidence)';

      if (age === 0) {
        fig.textContent = `${Math.round(adjLo)}–${Math.round(adjHi)} years`;
        note.textContent =
          'For a new roof, this is the full adjusted service-life range. The single best predictor of where yours lands is installation quality — verify installer certification and specification compliance now, while remedies exist.';
        next.innerHTML =
          'File the warranty, commission a post-installation inspection, and set a proactive maintenance cadence — see the <a href="/knowledge/">maintenance fundamentals</a>.';
      } else if (remHi <= 0) {
        fig.textContent = 'At or beyond expected life';
        note.textContent =
          'Based on population benchmarks, a roof of this age and profile is at or past its expected service life. That does not mean it has failed — it means condition assessment is overdue and budget planning should already be underway.';
        next.innerHTML =
          'Commission an independent condition assessment, then work through the <a href="/knowledge/guides/repair-or-replace/">Repair or Replace guide</a>.';
      } else {
        fig.textContent = remLo === remHi ? `≈ ${remHi} years` : `${remLo}–${remHi} years`;
        note.textContent =
          remLo <= 3
            ? 'The lower bound of this range is short. Budget planning for replacement should begin now, even if the roof is currently performing.'
            : 'A range this wide is honest: installation quality and undetected moisture — which this tool cannot see — determine where your roof falls within it.';
        next.innerHTML =
          remLo <= 5
            ? 'Start the <a href="/knowledge/guides/repair-or-replace/">Repair or Replace analysis</a> and get a moisture survey to narrow the range.'
            : 'Put the roof on a proactive inspection cadence and revisit annually. See <a href="/knowledge/">maintenance fundamentals</a>.';
      }
      result.hidden = false;
    });
  </script>
</Base>
