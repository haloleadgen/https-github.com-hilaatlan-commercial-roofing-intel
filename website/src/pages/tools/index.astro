---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusGroupedList from '../../components/StatusGroupedList.astro';
import type { Item } from '../../components/StatusGroupedList.astro';

/* No CRI tool is operational. Both calculators run on unvalidated placeholder data and
   have had their numeric output removed rather than hidden. This hub previously listed
   the estimator as "Available" and advertised a "Storm Damage Documentation Checklist"
   that does not exist and linked to this page itself. */
const tools: Item[] = [
  {
    title: 'Roof Life Expectancy Estimator',
    href: '/tools/roof-life-expectancy-estimator/',
    status: 'preliminary',
    description: 'Methodology published for scrutiny. Produces no estimate until Benchmarks v1.0 is validated.',
  },
  {
    title: 'Annual Maintenance Budget Planner',
    href: '/tools/maintenance-budget-planner/',
    status: 'draft',
    description: 'Draft methodology built on placeholder cost rates. Not yet reliable for budgeting.',
  },
  {
    title: 'Repair or Replace? How to Decide',
    href: '/knowledge/guides/repair-or-replace/',
    status: 'published',
    description: 'Not a calculator — a published, sourced decision framework. The alternative we recommend today.',
  },
];
---

<Base
  title="Tools"
  description="Decision-support calculators, planners, checklists, estimators, and assessment tools for commercial roofing — each with published methodology."
>
  <Breadcrumbs crumbs={[{ name: 'Tools' }]} />
  <PageHero
    eyebrow="Pillar 2 of 6"
    title="Tools"
    lede="Decision-support calculators, planners, checklists, estimators, and assessment tools. Every tool publishes its methodology, assumptions, and limitations — no black boxes."
  />

  <div class="container section--tight">
    <div class="callout callout--caution">
      <strong class="callout__title">No CRI calculator is operational yet</strong>
      <p>
        A CRI tool ships only when its methodology is public, its assumptions are
        documented, and its underlying data has been validated. Neither calculator meets
        that bar today, so neither will give you a number. We removed their output rather
        than let them look authoritative while a caveat sat further down the page.
      </p>
      <p style="margin-bottom: 0;">
        The methodologies are published anyway, so they can be examined before anyone is
        asked to trust them. Read the <a href="/about/methodology/">CRI Methodology</a>.
      </p>
    </div>

    <StatusGroupedList items={tools} />
  </div>
</Base>
