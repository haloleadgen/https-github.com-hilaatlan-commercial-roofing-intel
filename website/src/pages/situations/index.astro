---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusGroupedList from '../../components/StatusGroupedList.astro';
import type { Item } from '../../components/StatusGroupedList.astro';
import { getCollection } from 'astro:content';
import { isIndexable } from '../../data/status';

const entries = await getCollection('situations');
const urgencyLabel: Record<string, string> = {
  emergency: 'Emergency',
  'time-sensitive': 'Time-sensitive',
  planning: 'Planning',
};

const planned = [
  'Storm just hit my building',
  'Filing an insurance claim',
  'Preparing for hurricane season',
  'Buying a building (roof due diligence)',
  'My contractor proposal doesn’t make sense',
  'Budgeting for a roof replacement',
];

/* The complete pillar, grouped by publication status — a template placeholder must never
   look like a finished emergency guide. Indexable once anything here is reachable. */
const items: Item[] = entries
  .map((e) => ({
    title: e.data.title,
    href: `/situations/${e.id}/`,
    description: urgencyLabel[e.data.urgency],
    status: e.data.status,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const indexableCount = entries.filter((e) => isIndexable(e.data.status)).length;
---

<Base
  noindex={indexableCount === 0}
  title="Situations"
  description="Commercial roofing guidance organized around real decision moments — leaks, storm damage, insurance claims, repair versus replacement, hurricane preparation, and due diligence."
>
  <Breadcrumbs crumbs={[{ name: 'Situations' }]} />
  <PageHero
    eyebrow="Pillar 3 of 6"
    title="Situations"
    lede="You rarely need “roofing content.” You need to know what to do right now, in the situation you’re in. Start from the moment you’re facing."
  />

  <div class="container section--tight">
    <div class="callout callout--caution">
      <strong class="callout__title">If you are in an emergency right now</strong>
      Protect people first. Do not touch wet electrical equipment, do not walk through
      standing water to reach a breaker, do not stand beneath or puncture a sagging
      ceiling, and do not go onto a wet or storm-damaged roof. If there is danger, call
      your local emergency number.
    </div>

    <StatusGroupedList items={items} />

    <section class="section--tight">
      <h2>Coming in the launch library</h2>
      <ul>
        {planned.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</Base>
