---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('situations');
const urgencyLabel: Record<string, string> = {
  emergency: 'Emergency',
  'time-sensitive': 'Time-sensitive',
  planning: 'Planning',
};

const planned = [
  'Storm just hit my building',
  'Filing an insurance claim',
  'Preparing for hurricane season',
  'Buying a building (roof due diligence)',
  'My contractor proposal doesn’t make sense',
  'Budgeting for a roof replacement',
];

/* Thin-hub guard: noindex this hub while it has no published children.
   Every child here is currently noindexed pending editorial review, so an indexable
   hub listing only unreachable pages is a thin-content / crawl-dead-end signal on a
   domain with no authority yet. The hub re-enters the index automatically (here and
   in the sitemap filter in astro.config.mjs) as soon as one child is published. */
const publishedCount = entries.filter((e) => e.data.status === 'published').length;
---

<Base
  noindex={publishedCount === 0}
  title="Situations"
  description="Commercial roofing guidance organized around real decision moments — leaks, storm damage, insurance claims, repair versus replacement, hurricane preparation, and due diligence."
>
  <Breadcrumbs crumbs={[{ name: 'Situations' }]} />
  <PageHero
    eyebrow="Pillar 3 of 6"
    title="Situations"
    lede="You rarely need “roofing content.” You need to know what to do right now, in the situation you’re in. Start from the moment you’re facing."
  />

  <div class="container section--tight">
    {/* Screen-reader-only heading: the cards below are <h3>, so without an
        intervening <h2> this page jumped h1 -> h3 (WCAG 1.3.1). No visual change. */}
    <h2 class="visually-hidden">Situations</h2>
    <div class="grid grid--3">
      {entries.map((e) => (
        <Card
          title={e.data.title}
          href={`/situations/${e.id}/`}
          type={urgencyLabel[e.data.urgency]}
          description={e.data.description}
        />
      ))}
    </div>

    <section class="section--tight">
      <h2>Coming in the launch library</h2>
      <ul>
        {planned.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</Base>
