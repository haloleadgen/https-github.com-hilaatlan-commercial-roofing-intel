---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('roles');
const planned = [
  'Commercial property owners',
  'Facility managers',
  'Commercial real estate investors',
  'Industrial property owners',
  'Asset managers',
  'Developers',
  'Architects',
  'Engineers',
  'Insurance professionals',
];

/* Thin-hub guard: noindex this hub while it has no published children.
   Every child here is currently noindexed pending editorial review, so an indexable
   hub listing only unreachable pages is a thin-content / crawl-dead-end signal on a
   domain with no authority yet. The hub re-enters the index automatically (here and
   in the sitemap filter in astro.config.mjs) as soon as one child is published. */
const publishedCount = entries.filter((e) => e.data.status === 'published').length;
---

<Base
  noindex={publishedCount === 0}
  title="For Your Role"
  description="Commercial roofing resources tailored to property owners, property managers, facility managers, HOA boards, investors, developers, architects, engineers, and insurance professionals."
>
  <Breadcrumbs crumbs={[{ name: 'For Your Role' }]} />
  <PageHero
    eyebrow="Pillar 4 of 6"
    title="For Your Role"
    lede="The same roof raises different questions depending on the seat you sit in. These hubs organize CRI’s knowledge, tools, and data around your responsibilities."
  />

  <div class="container section--tight">
    {/* Screen-reader-only heading: the cards below are <h3>, so without an
        intervening <h2> this page jumped h1 -> h3 (WCAG 1.3.1). No visual change. */}
    <h2 class="visually-hidden">Role hubs</h2>
    <div class="grid grid--3">
      {entries.map((e) => (
        <Card
          title={e.data.title}
          href={`/for-your-role/${e.id}/`}
          type="Audience Hub"
          description={e.data.description}
        />
      ))}
    </div>

    <section class="section--tight">
      <h2>Role hubs in production</h2>
      <ul>
        {planned.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</Base>
