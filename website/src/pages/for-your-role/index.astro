---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusGroupedList from '../../components/StatusGroupedList.astro';
import type { Item } from '../../components/StatusGroupedList.astro';
import { getCollection } from 'astro:content';
import { isIndexable } from '../../data/status';

const entries = await getCollection('roles');
const planned = [
  'Commercial property owners',
  'Facility managers',
  'Commercial real estate investors',
  'Industrial property owners',
  'Asset managers',
  'Developers',
  'Architects',
  'Engineers',
  'Insurance professionals',
];

const items: Item[] = entries
  .map((e) => ({
    title: e.data.title,
    href: `/for-your-role/${e.id}/`,
    description: 'Audience hub',
    status: e.data.status,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const indexableCount = entries.filter((e) => isIndexable(e.data.status)).length;
---

<Base
  noindex={indexableCount === 0}
  title="For Your Role"
  description="Commercial roofing resources tailored to property owners, property managers, facility managers, HOA boards, investors, developers, architects, engineers, and insurance professionals."
>
  <Breadcrumbs crumbs={[{ name: 'For Your Role' }]} />
  <PageHero
    eyebrow="Pillar 4 of 6"
    title="For Your Role"
    lede="The same roof raises different questions depending on the seat you sit in. These hubs organize CRI’s knowledge, tools, and data around your responsibilities."
  />

  <div class="container section--tight">
    <StatusGroupedList
      items={items}
      emptyState="Neither role hub has been written yet — both exist only as templates. Rather than show you placeholders dressed up as guidance, they are listed below as what they are."
    />

    <section class="section--tight">
      <h2>Role hubs in production</h2>
      <ul>
        {planned.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</Base>
