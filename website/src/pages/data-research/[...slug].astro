---
import { yearOf } from '../../data/dates';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const entries = (await getCollection('datasets')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prevEntry: entries[i - 1] ?? null, nextEntry: entries[i + 1] ?? null },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);
const url = new URL(Astro.url.pathname, SITE.domain).href;
// yearOf parses as a local calendar date: new Date('2026-01-01').getFullYear() returned
// 2025 in any timezone behind UTC, putting the wrong year in the citation block.
const year = entry.data.updated ? yearOf(entry.data.updated) : new Date().getFullYear();

// Only a fully published dataset may be presented as citable. Anything preliminary,
// draft, or template must say so where the citation would otherwise sit.
const isCitable = entry.data.status === 'published';

const facts = [
  ...(entry.data.coverage ? [{ label: 'Coverage', value: entry.data.coverage }] : []),
  ...(entry.data.sampleSize ? [{ label: 'Sample', value: entry.data.sampleSize }] : []),
];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  typeLabel="Dataset"
  crumbs={[{ name: 'Data & Research', href: '/data-research/' }, { name: entry.data.title }]}
  updated={entry.data.updated}
  reviewed={entry.data.reviewed}
  sources={entry.data.sources}
  status={entry.data.status}
  takeaways={entry.data.takeaways}
  related={entry.data.related}
  headings={headings}
  body={entry.body ?? ''}
  facts={facts}
  prev={prevEntry ? { title: prevEntry.data.title, href: `/data-research/${prevEntry.id}/` } : undefined}
  next={nextEntry ? { title: nextEntry.data.title, href: `/data-research/${nextEntry.id}/` } : undefined}
  sectionLabel="Data & Research"
>
  {/* The suggested-citation block is offered ONLY for datasets that are actually
      citable. This page previously handed readers a formatted citation for a dataset
      whose own version history says "Not for citation until v1.0" — the page
      contradicted itself, and the citation block is the half a reader copies. */}
  <div class:list={['callout', isCitable ? 'callout--evidence' : 'callout--caution']}>
    <strong class="callout__title">Dataset facts</strong>
    <div>Methodology: <a href={entry.data.methodologyHref}>published methodology</a></div>
    {isCitable ? (
      <div style="margin-top: var(--space-2);">
        <strong>Suggested citation:</strong> Commercial Roofing Intel ({year}).
        “{entry.data.title}.” <em>{url}</em>
      </div>
    ) : (
      <div style="margin-top: var(--space-2);">
        <strong>Suggested citation:</strong> Not yet available. This dataset is preliminary
        and is not intended for citation. A stable citation format will be published with
        Version 1.0 after validation.
      </div>
    )}
  </div>

  <Content />
</ArticleLayout>
