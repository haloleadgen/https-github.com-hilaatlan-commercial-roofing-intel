---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusGroupedList from '../../components/StatusGroupedList.astro';
import type { Item } from '../../components/StatusGroupedList.astro';
import { getCollection } from 'astro:content';
import { isIndexable } from '../../data/status';

const entries = await getCollection('datasets');
const pipeline = [
  'Regional commercial roofing cost benchmarks',
  'Hurricane-performance analysis by roof system',
  'Membrane failure-mode research review',
  'Annual State of Commercial Roofing report',
];

const items: Item[] = entries
  .map((e) => ({
    title: e.data.title,
    href: `/data-research/${e.id}/`,
    description: e.data.coverage,
    status: e.data.status,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
const indexableCount = entries.filter((e) => isIndexable(e.data.status)).length;
const citableCount = entries.filter((e) => e.data.status === 'published').length;
---

<Base
  noindex={indexableCount === 0}
  title="Data & Research"
  description="Proprietary datasets, benchmarks, regional cost data, roof-life research, hurricane-performance analysis, and methodology reports from Commercial Roofing Intel."
>
  <Breadcrumbs crumbs={[{ name: 'Data & Research' }]} />
  <PageHero
    eyebrow="Pillar 5 of 6"
    title="Data & Research"
    lede="Datasets, benchmarks, and research — each published with its methodology, coverage, and limitations alongside the numbers. Nothing here is citable until it has been validated, and we say so on the page rather than in the footnotes."
  />

  <div class="container section--tight">
    {/* This band used to read "CRI data may be cited... Each dataset page includes a
        suggested citation" while the only dataset on the site says, in its own version
        history, "not for citation". The hub advertised a property the content denied. */}
    <div class:list={['callout', citableCount === 0 ? 'callout--caution' : '']}>
      <strong class="callout__title">Citation policy</strong>
      {citableCount === 0 ? (
        <p style="margin-bottom: 0;">
          <strong>Nothing here is citable yet.</strong> CRI has published no validated
          dataset. What exists below is preliminary and is marked as such on the page
          itself — no suggested citation is offered, because offering one would invite
          exactly the reliance the data cannot bear. When a dataset reaches v1.0, it will
          carry a stable citation format and may be cited with attribution and a link.
        </p>
      ) : (
        <p style="margin-bottom: 0;">
          Validated CRI datasets may be cited with attribution and a link to the source
          page. Each carries a suggested citation and its methodology disclosure.
          Preliminary datasets are marked and are not for citation.
        </p>
      )}
    </div>

    <StatusGroupedList items={items} />

    <section class="section--tight">
      <h2>Research pipeline</h2>
      <ul>
        {pipeline.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</Base>
