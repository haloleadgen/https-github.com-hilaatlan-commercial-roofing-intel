---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Message received" description="Your message has been received." noindex={true}>
  <PageHero
    title="Got it — thank you"
    lede="Your message is in. We read every message and reply as quickly as we can; correction reports are prioritised."
  />
  <div class="container section--tight">
    <p>While you wait, three useful places to go:</p>
    <ul>
      <li><a href="/knowledge/">Browse the knowledge base</a></li>
      <li><a href="/knowledge/guides/repair-or-replace/">Read the Repair-or-Replace decision guide</a></li>
      <li><a href="/situations/">Find guidance for your current situation</a></li>
    </ul>
  </div>
</Base>
