---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import StatusGroupedList from '../../components/StatusGroupedList.astro';
import type { Item } from '../../components/StatusGroupedList.astro';
import { getCollection } from 'astro:content';
import { isIndexable } from '../../data/status';

const entries = await getCollection('knowledge');

const label: Record<string, string> = {
  article: 'Encyclopedia',
  guide: 'Decision Guide',
  comparison: 'Comparison',
};

/* The complete pillar, grouped by publication status. Previously every entry rendered as
   an identical Card, so a template placeholder was visually indistinguishable from a
   finished, sourced article. */
const items: Item[] = entries
  .map((e) => ({
    title: e.data.title,
    href: `/knowledge/${e.id}/`,
    description: label[e.data.type],
    status: e.data.status,
  }))
  .sort((a, b) => a.title.localeCompare(b.title));

/* Indexable once anything here is reachable to a reader — published, technical-review,
   or preliminary. A hub listing only unreachable pages is a crawl dead end. */
const indexableCount = entries.filter((e) => isIndexable(e.data.status)).length;
---

<Base
  noindex={indexableCount === 0}
  title="Knowledge"
  description="Commercial roofing systems, materials, maintenance, replacement, coatings, warranties, and technical fundamentals — the CRI knowledge base."
>
  <Breadcrumbs crumbs={[{ name: 'Knowledge' }]} />
  <PageHero
    eyebrow="Pillar 1 of 6"
    title="Knowledge"
    lede="Commercial roofing systems, materials, maintenance, replacement, coatings, warranties, and technical fundamentals — written for decision-makers and sourced end to end."
  />

  <div class="container section--tight">
    <div class="callout">
      <strong class="callout__title">What you are looking at</strong>
      This library is early and deliberately small. Everything CRI has started is listed
      below, grouped by exactly how finished it is — including the parts that are not
      finished. Only work under <strong>Published</strong> has been editorially reviewed
      and sourced. Our <a href="/about/editorial-standards/">editorial standards</a>
      explain what each stage means.
    </div>

    <StatusGroupedList items={items} />

    <section class="section--tight" style="margin-top: var(--space-7);">
      <h2>Glossary</h2>
      <p class="lede" style="font-size: var(--text-base);">
        Plain-English definitions of commercial roofing terms, written so a first-time
        building owner can follow a contractor proposal line by line.
      </p>
      <p style="margin-top: var(--space-3);"><a class="btn btn--secondary" href="/glossary/">Browse the glossary</a></p>
    </section>
  </div>
</Base>
