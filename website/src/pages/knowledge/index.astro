---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { STATUS, isIndexable, type Status } from '../../data/status';
import { formatDate } from '../../data/dates';

const entries = await getCollection('knowledge');

/* V1 decision (founder-directed, Homepage/Knowledge completion sprints, July 2026):
   the public Knowledge page lists only reader-ready work. Draft and template entries
   are excluded from the public interface entirely — they remain in the repository and
   return here automatically when their status earns it. The prior version listed
   every entry grouped by status; the visible "Templates — not yet written" groups made
   the page feel unfinished to visitors. Honesty is preserved by the status label on
   every card and on every article page itself. */
const READER_READY = new Set<Status>(['published', 'technical-review']);
const ready = entries.filter((e) => READER_READY.has(e.data.status as Status));

const fmt = (d?: string) => (d ? formatDate(d, { month: 'short', day: 'numeric', year: 'numeric' }) : null);

/* Grouped by content type — logical groups with clear headings, per the readability
   directive — instead of one dense undifferentiated list. Empty groups are omitted. */
const TYPE_GROUPS = [
  {
    type: 'article',
    heading: 'System encyclopedia',
    blurb: 'What each roofing system is, how it performs, how it fails, and what to verify before specifying it.',
  },
  {
    type: 'guide',
    heading: 'Decision guides',
    blurb: 'Frameworks for the big decisions — what to weigh, what evidence to gather, and when each option deserves analysis.',
  },
  {
    type: 'comparison',
    heading: 'Comparisons',
    blurb: 'Side-by-side analysis of systems and specifications on fixed criteria.',
  },
].map((g) => ({
  ...g,
  entries: ready
    .filter((e) => e.data.type === g.type)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.entries.length > 0);

/* Indexable once anything here is reachable to a reader — published, technical-review,
   or preliminary. A hub listing only unreachable pages is a crawl dead end. */
const indexableCount = entries.filter((e) => isIndexable(e.data.status)).length;
---

<Base
  noindex={indexableCount === 0}
  title="Knowledge"
  description="The central commercial roofing reference library — source-cited articles, decision guides, and technical resources for commercial property owners and decision-makers."
>
  <Breadcrumbs crumbs={[{ name: 'Knowledge' }]} />
  <PageHero
    eyebrow="Pillar 1 of 6"
    title="Knowledge"
    lede="The central commercial roofing reference library: source-cited educational articles, practical decision guides, and technical resources — written so commercial property owners and decision-makers can make informed roofing decisions."
  />

  <div class="container section--tight">
    <p style="max-width: 70ch;">
      Every page in this library is written for the person carrying the decision, not the
      person selling the roof. Published work is editorially reviewed and lists its
      sources; each page carries its own publication status and review date, so you always
      know how mature the guidance is. The library grows only as new work clears
      <a href="/about/editorial-standards/">editorial review</a> — looking for something
      specific? <a href="/search/">Search the knowledge base</a>.
    </p>

    {TYPE_GROUPS.map((g) => (
      <section class="hub-group" style="margin-top: var(--space-7);">
        <h2>{g.heading}</h2>
        <p class="text-muted" style="font-size: var(--text-sm); margin-bottom: var(--space-4);">
          {g.blurb}
        </p>
        <ul class="hub-list">
          {g.entries.map((e) => (
            <li>
              <a href={`/knowledge/${e.id}/`}>{e.data.title}</a>
              <span class:list={['badge', `badge--status-${STATUS[e.data.status as Status].tone}`]}>
                {STATUS[e.data.status as Status].label}
              </span>
              <span class="meta" style="display:block;">
                {e.data.description}
                {fmt(e.data.updated) && ` · Updated ${fmt(e.data.updated)}`}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="section--tight" style="margin-top: var(--space-7);">
      <h2>Glossary</h2>
      <p class="lede" style="font-size: var(--text-base);">
        Plain-English definitions of commercial roofing terms, written so a first-time
        building owner can follow a contractor proposal line by line.
      </p>
      <p style="margin-top: var(--space-3);"><a class="btn btn--secondary" href="/glossary/">Browse the glossary</a></p>
    </section>
  </div>
</Base>
