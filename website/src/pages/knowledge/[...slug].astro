---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('knowledge')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title)
  );
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prevEntry: entries[i - 1] ?? null, nextEntry: entries[i + 1] ?? null },
  }));
}

const { entry, prevEntry, nextEntry } = Astro.props;
const { Content, headings } = await render(entry);

const typeLabel = { article: 'Encyclopedia', guide: 'Decision Guide', comparison: 'Comparison' }[
  entry.data.type
];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  typeLabel={typeLabel}
  crumbs={[{ name: 'Knowledge', href: '/knowledge/' }, { name: entry.data.title }]}
  updated={entry.data.updated}
  reviewed={entry.data.reviewed}
  sources={entry.data.sources}
  status={entry.data.status}
  takeaways={entry.data.takeaways}
  related={entry.data.related}
  headings={headings}
  body={entry.body ?? ''}
  prev={prevEntry ? { title: prevEntry.data.title, href: `/knowledge/${prevEntry.id}/` } : undefined}
  next={nextEntry ? { title: nextEntry.data.title, href: `/knowledge/${nextEntry.id}/` } : undefined}
  sectionLabel="Knowledge"
  showAssessment={entry.data.type === 'guide'}
>
  <Content />
</ArticleLayout>
