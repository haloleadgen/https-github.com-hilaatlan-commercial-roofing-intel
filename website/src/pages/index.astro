---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import PillarIcon from '../components/PillarIcon.astro';
import HeroArt from '../components/HeroArt.astro';
import SectionHead from '../components/SectionHead.astro';
import { SITE, PILLARS } from '../data/site';
import { getCollection } from 'astro:content';
import { publishedHrefs, isPromotable } from '../data/published';
import { formatDate } from '../data/dates';
import { isIndexable } from '../data/status';

const knowledge = await getCollection('knowledge');
const glossary = await getCollection('glossary');
const situations = await getCollection('situations');
const datasets = await getCollection('datasets');

const published = await publishedHrefs();
const isPub = (e: { data: { status?: string } }) => e.data.status === 'published';

/* Counts are computed from the live content collections at build time, and count
   ONLY published entries.
   These previously counted every entry regardless of status, so the homepage
   advertised "9 Encyclopedia articles" and "11 Glossary terms" when a reader could
   actually open 2 and 0 — everything else was noindexed sample/draft material.
   A "pre-launch" caption does not make an inflated number true, and that caption
   stops being true the moment the site launches.
   Zero-value rows are dropped rather than displayed as "0". */
const stats = [
  { value: knowledge.filter((e) => isPub(e) && e.data.type === 'article').length, one: 'Encyclopedia article', many: 'Encyclopedia articles' },
  { value: knowledge.filter((e) => isPub(e) && e.data.type === 'guide').length, one: 'Decision guide', many: 'Decision guides' },
  { value: knowledge.filter((e) => isPub(e) && e.data.type === 'comparison').length, one: 'Comparison', many: 'Comparisons' },
  { value: datasets.filter(isPub).length, one: 'Research dataset', many: 'Research datasets' },
  { value: glossary.filter(isPub).length, one: 'Glossary term', many: 'Glossary terms' },
  { value: situations.filter(isPub).length, one: 'Situation guide', many: 'Situation guides' },
]
  .filter((s) => s.value > 0)
  // With a library this small the counts are frequently 1, so singularise the label —
  // "1 Decision guides" undercuts the institutional voice the design works for.
  .map((s) => ({ value: s.value, label: s.value === 1 ? s.one : s.many }));

/* Published only — this band previously surfaced draft and sample pages as
   "recently updated", sending readers straight into placeholder content. */
const recentlyUpdated = [...knowledge, ...situations]
  .filter((e) => e.data.updated && isPub(e))
  .sort((a, b) => (b.data.updated! > a.data.updated! ? 1 : -1))
  .slice(0, 4);

const hrefFor = (e: any) =>
  situations.includes(e as never) ? `/situations/${e.id}/` : `/knowledge/${e.id}/`;

const fmt = (d: string) => formatDate(d, { month: 'short', day: 'numeric', year: 'numeric' });

/* Featured work. Every entry is filtered through isPromotable, so nothing unpublished can
   be featured even if someone adds it here later.
   Deliberately absent:
     - "TPO vs. EPDM" — still a template.
     - "Roof Life Expectancy Estimator" — in development; produces no estimate.
     - "White Roof vs. Black Roof" — still draft; its verification is not finished.
     - The EPDM card is NOT titled "The 50-Year Track Record". EPDM's *material history*
       spans 50+ years, but that phrasing reads as a service-life promise, and our own
       sourced planning range is 20–30 years. The safer heading is used instead. */
const editorsPicks = [
  { title: 'Facing Repair vs. Replace?', href: '/knowledge/guides/repair-or-replace/', note: 'The framework for the most consequential decision a roof forces — published and sourced' },
  { title: 'EPDM Roofing: Performance, Uses, and Tradeoffs', href: '/knowledge/epdm-roofing-systems/', note: 'Where the oldest single-ply system still wins, and where it does not' },
  { title: 'TPO Roofing Systems: An Owner\'s Reference', href: '/knowledge/tpo-roofing-systems/', note: 'What to verify before specifying the most common commercial membrane' },
].filter((p) => isPromotable(p.href, published));

/* One featured situation, and only because it is now editorially complete and sourced
   against Ready.gov and OSHA. Its own page discloses that technical review is pending.
   People arrive at a site like this mid-emergency; burying the emergency guidance to look
   tidy would be its own failure. */
const featuredSituation = isPromotable('/situations/my-roof-is-leaking/', published)
  ? { title: 'My Roof Is Leaking — What To Do Right Now', href: '/situations/my-roof-is-leaking/' }
  : null;

/* Same rule for the audience strip. */
const audienceCards = [
  { title: 'Property Managers', href: '/for-your-role/property-managers/', description: 'Triage, budgeting, vendor oversight, and owner communication.' },
  { title: 'HOA & Condo Boards', href: '/for-your-role/hoa-boards/', description: 'Reserve planning, special assessments, and defensible board decisions.' },
].filter((c) => isPromotable(c.href, published));
---

<Base title="Home" description={SITE.description}>
  <!-- HERO: what CRI is, why trust it, where to start — in one viewport -->
  <section class="home-hero">
    <HeroArt />
    <div class="container">
      <h1>The trusted knowledge platform for commercial roofing decisions.</h1>
      {/* "decision tools" is not claimed here: no CRI calculator is operational — both
          are gated pending validated data. Do not restore the phrase until one is. */}
      <p class="lede">
        Independent, sourced guidance for the people who actually carry commercial roofing
        decisions — owners, managers, and boards. Small on purpose, and clear about what it
        does not yet know.
      </p>

      <div class="hero-search hero-search--home">
        <form action="/search/" method="get" role="search" aria-label="Search the knowledge base">
          <input
            id="hero-q"
            type="text"
            name="q"
            placeholder="Search: TPO, ponding water, repair vs replace, storm damage…"
            aria-label="Search the knowledge base"
            autocomplete="off"
          />
          <button type="submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
            </svg>
            Search
          </button>
        </form>
        <p class="hero-search__hint">
          Press <kbd style="border:1px solid rgba(255,255,255,0.35); border-radius:4px; padding:0 5px;">/</kbd> anywhere to search
          — or start from <a href="/situations/">your situation</a> or <a href="/for-your-role/">your role</a>.
        </p>
      </div>

      {/* "Every claim sourced" was an absolute the site could not keep — a published
          guide carried two uncited numeric thresholds when this claim was written. Each
          bullet below is now something a reader can check on this site today. */}
      <div class="home-hero__proof" style="margin-top: var(--space-6);">
        <span>✓ Editorial independence — <a href="/about/editorial-standards/" style="color: var(--cri-blue-400);">public standards</a></span>
        <span>✓ Every published page lists its sources</span>
        <span>✓ <a href="/about/corrections/" style="color: var(--cri-blue-400);">Public corrections policy</a></span>
      </div>
    </div>
  </section>

  {/* STATS BAND — build-time counts of PUBLISHED entries only.
      The note no longer says "sample library": the counts are now real, so the
      caveat that excused inflated numbers is neither needed nor true. */}
  <section class="stats-band" aria-label="Knowledge base at a glance">
    <div class="container">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat__value">{s.value}</div>
          <div class="stat__label">{s.label}</div>
        </div>
      ))}
      <p class="stats-band__note">
        Every count is of published, sourced work — the library is early and grows only
        as each piece clears <a href="/about/editorial-standards/">editorial review</a>.
      </p>
    </div>
  </section>

  <!-- SIX PILLARS -->
  <section class="section" aria-labelledby="pillars-heading">
    <div class="container">
      <SectionHead
        id="pillars-heading"
        eyebrow="Start anywhere"
        title="Six ways into the knowledge base"
      />
      <div class="grid grid--3">
        {PILLARS.map((pillar) => (
          <article class="card card--pillar">
            <PillarIcon icon={pillar.icon} />
            <h3><a href={pillar.href}>{pillar.name}</a></h3>
            <p class="text-muted" style="font-size: var(--text-sm);">{pillar.summary}</p>
            <span class="card__arrow" aria-hidden="true">Explore →</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LIVING INSTITUTION BAND -->
  <section class="section section--alt" aria-labelledby="pulse-heading">
    <div class="container">
      <SectionHead
        id="pulse-heading"
        eyebrow="The research desk"
        title="What’s moving at CRI"
        lede="Everything below is published and sourced. This library is deliberately small — it grows only as each piece clears editorial review."
      />
      {/* The "Latest research" card that sat here linked to Roof Life Expectancy
          Benchmarks v0.1 — a preliminary dataset whose own page says "not for citation".
          The homepage must not headline it as "Latest research". Restore when v1.0 is
          validated and published. */}
      {featuredSituation && (
        <div class="callout callout--caution" style="margin-bottom: var(--space-5);">
          <strong class="callout__title">In the middle of it right now?</strong>
          <a href={featuredSituation.href}>{featuredSituation.title}</a> — protect people
          first, document before cleanup, and do not sign anything today.
        </div>
      )}
      <div class="grid grid--2">
        <div>
          <h3 style="margin-bottom: var(--space-3);">Recently updated</h3>
          <ul class="pulse-list">
            {recentlyUpdated.map((e) => (
              <li>
                <a href={hrefFor(e)}>{e.data.title}</a>
                <span class="meta">Updated {fmt(e.data.updated!)} · Reviewed by {e.data.reviewed}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 style="margin-bottom: var(--space-3);">Editor’s picks</h3>
          <ul class="pulse-list">
            {editorsPicks.map((p) => (
              <li>
                <a href={p.href}>{p.title}</a>
                <span class="meta">{p.note}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* FEATURED COMPARISON + NEWEST TOOL — removed for V1.
      Both halves promoted unpublished pages: "TPO vs. EPDM" is `status: sample`,
      and the Roof Life Expectancy Estimator is noindexed pending Benchmarks v1.0.
      The section also reprinted the sample dataset's service-life figures directly
      on the homepage, giving placeholder numbers top-level prominence.
      Restore when a comparison and the estimator are genuinely published. */}

  {/* SITUATIONS STRIP — removed for V1.
      Headlined "My roof is leaking" and "Storm just hit"; both are `status: sample`
      and their bodies are literal "Placeholder:" stubs. Promoting emergency triage
      that leads to placeholder copy is the worst failure mode this site has, so the
      strip is gone until those pages carry real, sourced production content. */}

  <!-- TRUST BAND -->
  <section class="section section--navy" aria-labelledby="trust-heading">
    <div class="container">
      <p class="eyebrow">Why trust CRI</p>
      <h2 id="trust-heading">Built like a reference institution, governed like one</h2>
      <div class="grid grid--3" style="margin-top: var(--space-5);">
        <div>
          <h3>Independent</h3>
          <p style="font-size: var(--text-sm);">
            Editorial decisions are made solely by our editors, under public standards.
            Every relationship is <a href="/about/funding-and-relationships/" style="color: var(--cri-blue-400);">disclosed</a>.
          </p>
        </div>
        {/* Was: "Evidence-based — Claims trace to standards bodies, technical data, and
            our own datasets — with published methodology for every number." CRI has no
            validated dataset, and the one calculator's methodology is explicitly a
            placeholder, so "every number" was not a claim this site could keep. */}
        <div>
          <h3>Sourced, and honest about the gaps</h3>
          <p style="font-size: var(--text-sm);">
            Published pages list the documents behind them, and say plainly where the
            evidence runs out. Where our own data is not yet validated, we mark it and
            decline to publish a number rather than dress up a guess. See our
            <a href="/about/methodology/" style="color: var(--cri-blue-400);">methodology</a>.
          </p>
        </div>
        <div>
          <h3>Accountable</h3>
          <p style="font-size: var(--text-sm);">
            Review dates on every page. Errors fixed in public under our
            <a href="/about/corrections/" style="color: var(--cri-blue-400);">corrections policy</a>.
          </p>
        </div>
      </div>
      <div class="home-hero__actions">
        <a class="btn btn--secondary" href="/about/how-cri-works/">How CRI works</a>
        <a class="btn btn--secondary" href="/about/editorial-standards/">Editorial standards</a>
        <a class="btn btn--secondary" href="/about/methodology/">Methodology</a>
      </div>
    </div>
  </section>

  <!-- AUDIENCE STRIP -->
  <section class="section" aria-labelledby="audience-heading">
    <div class="container">
      <SectionHead
        id="audience-heading"
        eyebrow="For your role"
        title="Guidance built for the seat you sit in"
        linkHref="/for-your-role/"
        linkLabel="All roles"
      />
      {/* Property Managers and HOA & Condo Boards cards sat here while both pages are
          `status: sample`. They return automatically once published — see audienceCards. */}
      <div class="grid grid--3">
        {audienceCards.map((c) => (
          <Card title={c.title} href={c.href} type="Audience" description={c.description} cta="Open hub" />
        ))}
        <Card title="All roles" href="/for-your-role/" type="Pillar" description="Owners, facility managers, investors, developers, architects, engineers, insurance professionals." cta="Browse" />
      </div>
    </div>
  </section>
</Base>
