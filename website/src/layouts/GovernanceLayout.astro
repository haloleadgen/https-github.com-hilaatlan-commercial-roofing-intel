---
/**
 * Layout for governance / trust pages (About, Mission, Editorial Standards,
 * Methodology, Funding & Relationships, Corrections, How CRI Works).
 */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import { GOVERNANCE } from '../data/site';

interface Props {
  title: string;
  description: string;
  lede?: string;
  updated?: string;
  /** crumb shown after About; omit on the About hub itself */
  crumbName?: string;
  /** Governance pages awaiting founder confirmation or counsel review are held out of
   *  the index and out of search until the wording is signed off. They stay reachable
   *  for readers — a disclosure page should never be hard to find — but CRI does not
   *  solicit traffic to legal language that is not final. */
  noindex?: boolean;
  /** Optional JSON-LD object passed through to Base (e.g. Person on the About page). */
  schema?: Record<string, unknown>;
}
const { title, description, lede, updated, crumbName, noindex = false, schema } = Astro.props;
const crumbs = crumbName
  ? [{ name: 'About', href: '/about/' }, { name: crumbName }]
  : [{ name: 'About' }];
const currentPath = Astro.url.pathname;
---

<Base title={title} description={description} noindex={noindex} schema={schema}>
  <Breadcrumbs crumbs={crumbs} />
  <PageHero eyebrow="Trust & Governance" title={title} lede={lede ?? description} />

  <div class="container section--tight">
    <div class="prose" {...(noindex ? {} : { 'data-pagefind-body': true })}>
      {updated && (
        <p class="text-muted" style="font-size: var(--text-sm);">
          Effective and last reviewed: <time datetime={updated}>{updated}</time>
        </p>
      )}
      <slot />
    </div>

    <nav class="related" aria-label="Governance pages">
      <h2>CRI’s trust framework</h2>
      <ul>
        {GOVERNANCE.map((g) => (
          <li>
            {currentPath === g.href ? (
              <strong>{g.name} (this page)</strong>
            ) : (
              <a href={g.href}>{g.name}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
