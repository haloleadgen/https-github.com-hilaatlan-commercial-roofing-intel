---
/**
 * Shared long-form template with sidebar: TOC, key facts, review panel,
 * reading time, reading-progress indicator, prev/next, related resources.
 */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TrustMeta from '../components/TrustMeta.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import SampleNotice from '../components/SampleNotice.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import TOC from '../components/TOC.astro';
import KeyFacts from '../components/KeyFacts.astro';
import PrevNext from '../components/PrevNext.astro';
import AssessmentNote from '../components/AssessmentNote.astro';
import Sources from '../components/Sources.astro';
import { SITE } from '../data/site';
import { formatDate } from '../data/dates';
import { STATUS, EDITOR, isIndexable, type Status } from '../data/status';
import type { Source } from '../data/sources';

interface Crumb { name: string; href?: string; }
interface RelatedItem { title: string; href: string; type?: string; description?: string; }
interface Heading { depth: number; slug: string; text: string; }
interface Fact { label: string; value: string; }
interface Link { title: string; href: string; }

interface Props {
  title: string;
  description: string;
  typeLabel: string;
  crumbs: Crumb[];
  updated?: string;
  reviewed?: string;
  sources?: Source[];
  status?: Status;
  takeaways?: string[];
  related?: RelatedItem[];
  headings?: Heading[];
  facts?: Fact[];
  body?: string;
  prev?: Link;
  next?: Link;
  sectionLabel?: string;
  showAssessment?: boolean;
}

const {
  title, description, typeLabel, crumbs,
  updated, reviewed, sources = [],
  status = 'template', takeaways = [], related = [],
  headings = [], facts = [], body = '',
  prev, next, sectionLabel, showAssessment = false,
} = Astro.props;

const words = body.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 220));

const fmt = (d?: string) => (d ? formatDate(d) : undefined);

const meta = STATUS[status] ?? STATUS.template;
// Derived from the structured array, never hand-typed.
const sourceCount = sources.length;

const reviewFacts: Fact[] = [
  { label: 'Content type', value: typeLabel },
  ...(updated ? [{ label: 'Last updated', value: fmt(updated)! }] : []),
  { label: 'Publication status', value: meta.label },
  // Editorial review is stated separately from technical review, and only where it
  // actually happened. This sidebar previously asserted "Reviewed by: Hila Atlan,
  // Founder & Editor-in-Chief" over template content that had had no such review.
  ...(meta.showEditorialReview
    ? [{ label: 'Editorial review', value: reviewed ?? EDITOR }]
    : []),
  ...(status === 'technical-review'
    ? [{ label: 'Technical review', value: 'Pending subject-matter verification' }]
    : []),
  ...(meta.showSourceCount && sourceCount > 0
    ? [{ label: 'Sources cited', value: String(sourceCount) }]
    : []),
  { label: 'Reading time', value: `${readingMinutes} min` },
];

/* Schema is emitted only for pages a crawler may index, and reflects the real
   publication state. Emitting Article markup for template pages asserted to machines
   what the visible banner denied to humans. `editor` names the editorial reviewer only
   where an editorial review happened; it is never presented as technical review. */
const articleSchema = isIndexable(status)
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      ...(updated ? { dateModified: updated, datePublished: updated } : {}),
      author: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.domain },
      ...(meta.showEditorialReview
        ? { editor: { '@type': 'Person', name: reviewed ?? EDITOR } }
        : {}),
      ...(sourceCount > 0
        ? { citation: sources.map((x) => x.url ?? `${x.title} — ${x.publisher}`) }
        : {}),
      creativeWorkStatus: meta.label,
      mainEntityOfPage: new URL(Astro.url.pathname, SITE.domain).href,
    }
  : undefined;
---

<Base title={title} description={description} schema={articleSchema} noindex={!isIndexable(status)}>
  <div class="read-progress" aria-hidden="true"></div>
  <Breadcrumbs crumbs={crumbs} />

  <div class="container section--tight">
    <div class="article-grid">
      {/* data-pagefind-body only when published. Search is a discovery surface like
          the nav: indexing draft/sample pages meant a reader searching "TPO" got 9
          results, most of them placeholder pages carrying a "Sample content" banner.
          Pagefind indexed 44 pages while only 3 were published. */}
      <article {...(isIndexable(status) ? { 'data-pagefind-body': true } : {})} id="article-body">
        <header>
          <p class="eyebrow" data-pagefind-filter="type">{typeLabel}</p>
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <TrustMeta updated={updated} reviewed={reviewed} sources={sources} minutes={readingMinutes} status={status} />
        </header>

        <SampleNotice status={status} />
        {takeaways.length > 0 && <KeyTakeaways items={takeaways} />}

        <div class="prose">
          <slot />
        </div>

        <Sources items={sources} />

        {showAssessment && <AssessmentNote />}

        <PrevNext prev={prev} next={next} label={sectionLabel} />
      </article>

      <aside class="article-aside" aria-label="Article information">
        <KeyFacts facts={[...facts, ...reviewFacts]} />
        <TOC headings={headings} />
        <div class="aside-panel">
          <h2>Accountability</h2>
          <ul>
            <li><a href="/about/editorial-standards/">How this page is governed</a></li>
            <li><a href="/about/corrections/">Report an error</a></li>
            <li><button type="button" onclick="window.print()" style="background:none;border:0;padding:0;color:var(--cri-blue-500);text-decoration:underline;cursor:pointer;font:inherit;">Print this page</button></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>

  <RelatedLinks items={related} />

  <script>
    const bar = document.querySelector<HTMLElement>('.read-progress');
    const article = document.getElementById('article-body');
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const done = Math.min(Math.max(-rect.top, 0), Math.max(total, 1));
        bar.style.width = total > 0 ? `${(done / total) * 100}%` : '0';
      };
      document.addEventListener('scroll', update, { passive: true });
      update();
    }
  </script>
</Base>
